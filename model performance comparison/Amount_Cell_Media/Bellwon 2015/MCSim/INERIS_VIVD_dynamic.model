# Dynamic Virtual In Vitro Distribution Model (VIVD)
# Frederic Bois, April 2017.
#
# GNU MCSim dynamic version, with linear metabolism.
# This model is based on the static Simcyp VIVD model 
# developed by C. Fisher in October 2016.
#
# Units:
# quantities:     mol
# volumes:        L
# concentrations: mol/L
# time:           minutes

States  = {Q_met};

Inputs  = {Q_total};   # input dose

Outputs = {C_parent,   # concentrations in mol/L
           C_free_diss,
           C_cells,    # ~
           C_air,
           C_IW,
           C_lyso,
           C_mito,
           C_plastic,  # ~                 mol/m2
           Q_media_free,
           Q_parent,   # quantities in mol
           Q_cells,
           Q_media,
           Q_air,
           Q_plastic,
           Q_IW,
           Q_lyso,
           Q_mito};


# Constants
Pi = 3.1415926535897932384626433;

# Parameters

# The defaults here represent hepatocytes cultured in a
# 384-well plate in 50µl media 10%(v/v) FBS at 37°C

temp         = 37;       # culture temperature (degrees celcius)
Vmedium      = 50;       # (uL)
Sysdiameter  = 3.8;      # (mm)
Vwell        = 130.4232; # (ul), 1mm3 = 1ul
Celldiameter = 30;       # (um)
ncell        = 30000;


# Cell composition data

pH_IW   = 7.0;     # intracellular water pH

f_NL    = 0.0348;  # fraction (v/v) neutral lipid
f_NLrbc = 0.0017;  # ~        in red blood cells

f_NP    = 0.0252;  # fraction (v/v) neutral phospholipid
f_NPrbc = 0.0029;  # ~        in red blood cells

f_IW    = 0.586;   # fration (v/v) intracellular water
f_IWrbc = 0.666;   # ~       for red blood cells

AP      = 5.09;    # acidic phospholipid concentration (mg/g)
AP_rbc  = 0.44;    # ~      in red blood cells

pH_mito = 8.0;     # pH mitochondria
pH_lyso = 4.0;     # pH lysosome

f_lyso  = 0.01;    # fraction (v/v) lysosome
f_mito  = 0.1;     # fraction (v/v) mitochondria


# Culture medium composition

pH_medium     = 7.4;      # culture medium pH
f_serum       = 0.1;      # fraction (v/v) of serum in total media
pH_serum      = 7.0;      # FBS pH
f_FBS_albumin = 0.0176;   # fraction (v/v) of albumin in FBS
f_FBS_NL      = 0.00046;  # fraction (v/v) of neutral lipid in FBS


# Physicochemical properties of test substance
# - cmp_type (compound type) must one of:
#   1:neutral
#   2:monobase
#   3:dibase
#   4:monoacid
#   5:diacid
#   6:ampholyte
#
# - Pow is the octanol water partition coefficient at 25 degrees Celsius
#
# - Kaw is the air water partition coefficient (Henry's law constant;
#   Pa m3/mol) at 25 degrees Celsius
#
# - fu is the fraction unbound in fetal bovine serum; if no user input
#   is provided the model will predict fu
#
# - BP is the blood to plasma ratio of test compound used to predict
#   binding to acidic phospholipids; users MUST provide a value
#

cmp_type;
pKa1;
pKa2;
MW;
logPow_Tref;
logKAW_Tref;
BP;
fu;

# Metabolic clearance per cell, L/min
K_met;


# Parameters computed in Initialize
KAW;
fu_diluted;
Vbulk;
f_FBS_aq;
fui;
Vair;
kpsub;
Vtotalcell;
kplastic;
Sam;
kpusub;
kpu_IW;
kpu_lyso;
kpu_mito;


Initialize {

  # Calculated parameters and unit conversions

  Sysr      = Sysdiameter / 2.0 * 1e-3; # (m)
  Cellr     = Celldiameter / 2.0 * 1e-6; # (m)
  SAculture = Pi * Sysr * Sysr; # culturable surface area; m^2

  # total volume of the system (L), mililitres -> litres
  Vsys  = Vwell * 1e-6;

  # volume medium, microlitres -> litres
  Vbulk = Vmedium * 1e-6;

  # Volume of a spherical cell, m^3 -> litres
  Vcell = 4 / 3.0 * Pi *Cellr * Cellr * Cellr * 1e3 * 0.5;

  # Total volume of cells (L)
  Vtotalcell = Vcell * ncell;

  # volume of air in head space (L)
  Vair = Vsys - Vbulk - Vtotalcell;

  f_FBS_aq = 1 - (f_FBS_albumin + f_FBS_NL);

  # Index compounds based on compound type

  maxpKa = (pKa1 > pKa2 ? pKa1 : pKa2);

  neutral     = ((cmp_type == 1)                 ? 1 : 0);
  wmbase      = ((cmp_type == 2) * (pKa1   <  7) ? 1 : 0);
  smbase      = ((cmp_type == 2) * (pKa1   >= 7) ? 1 : 0);
  wdibase     = ((cmp_type == 3) * (maxpKa <  7) ? 1 : 0);
  sdibase     = ((cmp_type == 3) * (maxpKa >= 7) ? 1 : 0);
  monoacid    = ((cmp_type == 4)                 ? 1 : 0);
  diacid      = ((cmp_type == 5)                 ? 1 : 0);
  wbampholyte = ((cmp_type == 6) * (pKa2   <  7) ? 1 : 0);
  sbampholyte = ((cmp_type == 6) * (pKa2   >= 7) ? 1 : 0);


  # Correct inputs for system temperature
  # Assumes that user inputs are at reference temperature 25 degrees Celsius
  R = 8.31441621; #  gas constant, J/K/mol
  Tref = 25   + 273.15; # convert from Celsius to Kelvin
  Tsys = temp + 273.15; # convert from Celsius to Kelvin
  dUOW = -20000;  # default value
  dUAW =  60000;  # default value

  logPow_Tsys = logPow_Tref - (dUOW / (log(10) * R)) * (1 / Tsys - 1 / Tref);
  logKAW_Tsys = logKAW_Tref - (dUAW / (log(10) * R)) * (1 / Tsys - 1 / Tref);

  # predict logPvow from logPow_Tsys
  logPvow_Tsys = 1.115 * logPow_Tsys-1.35;

  # olive oil/water partition coefficient, surrogate for neutral lipid
  PNL = pow(10, logPvow_Tsys);

  # octanol/water partion coefficient; surrogate neutral phospholipid
  PNP = pow(10, logPow_Tsys);

  # air/water partition coefficient
  KAW = pow(10, logKAW_Tsys);


  # Fraction ionised in cells and media
  # '+' is used for 'OR' in the following conditionals

  # In medium

  Y1_medium  = (wmbase + smbase ? pow(10, pKa1 - pH_medium) :
                  wdibase + sdibase ? pow(10, pKa1 - pH_medium) +
                                      pow(10, pKa2 - pH_medium) :
                    monoacid ? pow(10, pH_medium - pKa1) :
                      diacid ? pow(10, pH_medium - pKa1) +
                               pow(10, pH_medium - pKa2) : 0);

  Y1a_medium = (wbampholyte + sbampholyte ? pow(10, pH_medium - pKa1) : 0);

  Y1b_medium = (wbampholyte + sbampholyte ? pow(10, pKa2 - pH_medium) : 0);

  Y2_medium  = (wdibase + sdibase ? pow(10, pKa1 + pKa2 - 2 * pH_medium) :
                  diacid ? pow(10, 2 * pH_medium - pKa1 - pKa2) :
                    wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);


  # In intra-cellular water

  Y1_IW      = (wmbase + smbase ? pow(10, pKa1 - pH_IW) :
                  wdibase + sdibase ? pow(10, pKa1 - pH_IW) +
                                      pow(10, pKa2 - pH_IW) :
                    monoacid ? pow(10, pH_IW - pKa1) :
                      diacid ? pow(10, pH_IW - pKa1) +
                               pow(10, pH_IW - pKa2) : 0);

  Y1a_IW     = (wbampholyte + sbampholyte ? pow(10, pH_IW - pKa1) : 0);

  Y1b_IW     = (wbampholyte + sbampholyte ? pow(10, pKa2 - pH_IW) : 0);

  Y2_IW      = (wdibase + sdibase ? pow(10, pKa1 + pKa2 - 2 * pH_IW) :
                  diacid ? pow(10, 2 * pH_IW - pKa1 - pKa2) :
                    wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);


  # In red blood cells

  Y1_IWrbc   = (smbase ? pow(10, pKa1 - 7.22) :
                  sdibase ? pow(10, pKa1 - 7.22) +
                            pow(10, pKa2 - 7.22)    : 0);

  Y1a_IWrbc  = (wbampholyte + sbampholyte ? pow(10, 7.22 - pKa1) : 0);

  Y1b_IWrbc  = (wbampholyte + sbampholyte ? pow(10, pKa2 - 7.22) : 0);

  Y2_IWrbc   = (sdibase ? pow(10, pKa1 + pKa2 - 14.44) :
                  wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);


  # In lysozymes

  Y1_lyso    = (wmbase + smbase ? pow(10, pKa1 - pH_lyso) :
                  wdibase + sdibase ? pow(10, pKa1 - pH_lyso) +
                                      pow(10, pKa2 - pH_lyso) :
                    monoacid ? pow(10, pH_lyso - pKa1) :
                      diacid ? pow(10, pH_lyso - pKa1) +
                               pow(10, pH_lyso - pKa2) : 0);

  Y1a_lyso   = (wbampholyte + sbampholyte ? pow(10, pH_lyso - pKa1) : 0);

  Y1b_lyso   = (wbampholyte + sbampholyte ? pow(10, pKa2 - pH_lyso) : 0);

  Y2_lyso    = (wdibase + sdibase ? pow(10, pKa1 + pKa2 - 2 * pH_lyso) :
                  diacid ? pow(10, 2 * pH_lyso - pKa1 - pKa2) :
                    wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);


  # In mitochondria

  Y1_mito    = (wmbase + smbase ? pow(10, pKa1 - pH_mito) :
                  wdibase + sdibase ? pow(10, pKa1 - pH_mito) +
                                      pow(10, pKa2 - pH_mito) :
                    monoacid ? pow(10, pH_mito - pKa1) :
                      diacid ? pow(10, pH_mito - pKa1) +
                               pow(10, pH_mito - pKa2) : 0);

  Y1a_mito   = (wbampholyte + sbampholyte ? pow(10, pH_mito - pKa1) : 0);

  Y1b_mito   = (wbampholyte + sbampholyte ? pow(10, pKa2 - pH_mito) : 0);

  Y2_mito    = (wdibase + sdibase ? pow(10, pKa1 + pKa2 - 2 * pH_mito) :
                  diacid ? pow(10, 2 * pH_mito - pKa1 - pKa2) :
                    wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);


  # In fetal bovine serum

  Y1_serum   = (wmbase + smbase ? pow(10, pKa1 - pH_serum) :
                  wdibase + sdibase ? pow(10, pKa1 - pH_serum) +
                                      pow(10, pKa2 - pH_serum) :
                    monoacid ? pow(10, pH_serum - pKa1) :
                      diacid ? pow(10, pH_serum - pKa1) +
                               pow(10, pH_serum - pKa2) : 0);


  Y1a_serum  = (wbampholyte + sbampholyte ? pow(10, pH_serum - pKa1) : 0);

  Y1b_serum  = (wbampholyte + sbampholyte ? pow(10, pKa2 - pH_serum) : 0);

  Y2_serum   = (wdibase + sdibase ? pow(10, pKa1 + pKa2 - 2 * pH_serum) :
                  diacid ? pow(10, 2 * pH_serum - pKa1 - pKa2) :
                    wbampholyte + sbampholyte ? pow(10, pKa2 - pKa1) : 0);

  # fraction unionized in serum
  fui = (wbampholyte + sbampholyte ?
           1 / (1 + Y1a_serum + Y1b_serum + Y2_serum) :
           neutral ? 1 : 1 / (1 + Y1_serum + Y2_serum));

  # fraction ionized in serum
  fi = 1 - fui;

  # percentage ionized in serum
  # fi_percent = fi * 100;


  # Fraction unbound in serum (user input or predicted)
  # Predicted
  kalbumin = (logPow_Tsys < 4.5 ? pow(10, 1.08 * logPow_Tsys - 0.7) :
                                  pow(10, 0.37 * logPow_Tsys + 2.56));

  fu_FBS = f_FBS_aq / (f_FBS_aq + kalbumin * f_FBS_albumin +
                       ((PNL * f_FBS_NL) / (1 + fi)));

  # Use user input if available otherwise (indicated by -1) use predicted
  fu = (fu < 0 ? fu_FBS : fu);

  # Correct for dilution of serum fu in total media
  # Note: this will correct user input and predicted fu values
  fu_diluted = fu / (f_serum * (1-fu) + fu);

  # Calculate N1 AND N2
  F = 96484.56; # C/mol
  T = Tsys; # Temperature in K
  mV_cell = -0.07; # cell membrane potential V
  mV_rbc  = -0.01; # RBC membrane potential V
  mV_mito = -0.12; # mitochondrial membrane potential V
  mV_lyso =  0.01; # lysosomal membrane potential V

  PermR_mcat = pow(10, -2.3); # monoprotic cations
  PermR_dcat = pow(10, -10);  # diprotic cations
  PermR_mani = pow(10, -3.3); # monoprotic anions
  PermR_dani = pow(10, -10);  # diprotic anions
  PermR_amp  = pow(10, -2);   # ampholytes

  # Cell

  N1  = (diacid + monoacid ? -mV_cell * F / (R * T) :
           sdibase + smbase + wdibase + wmbase ? mV_cell * F / (R * T) : 0);

  N1a = (wbampholyte + sbampholyte ? -mV_cell * F / (R * T) : 0);

  N1b = (wbampholyte + sbampholyte ?  mV_cell * F / (R * T) : 0);

  N2  = (wdibase + sdibase ? 2 * mV_cell * F / (R * T) :
           diacid ? -2 * mV_cell * F / (R * T) : 0);


  # Mitochondria

  N1mito  = (diacid + monoacid ? -mV_mito * F / (R * T) :
               sdibase + smbase + wdibase + wmbase ? mV_mito * F / (R * T) : 0);

  N1amito = (wbampholyte + sbampholyte ? -mV_mito * F / (R * T) : 0);

  N1bmito = (wbampholyte + sbampholyte ?  mV_mito * F / (R * T) : 0);

  N2mito  = (wdibase + sdibase ? 2 * mV_mito * F / (R * T) :
               diacid ? -2 * mV_mito * F / (R * T) : 0);


  # Red blood cells

  N1rbc  = (sdibase + smbase ? mV_rbc * F / (R * T) : 0);

  N1arbc = (wbampholyte + sbampholyte ? -mV_rbc * F / (R * T) : 0);

  N1brbc = (wbampholyte + sbampholyte ?  mV_rbc * F / (R * T) : 0);

  N2rbc  = (sdibase ? 2 * mV_rbc * F / (R * T) : 0);


  # Lysozymes

  N1lyso  = (diacid + monoacid ? -mV_lyso * F / (R * T) :
               sdibase + smbase + wdibase + wmbase ? mV_lyso * F / (R * T) : 0);

  N1alyso = (wbampholyte + sbampholyte ? -mV_lyso * F / (R * T) : 0);

  N1blyso = (wbampholyte + sbampholyte ?  mV_lyso * F / (R * T) : 0);

  N2lyso  = (wdibase + sdibase ? 2 * mV_lyso * F / (R * T) :
               diacid ? -2 * mV_lyso * F / (R * T) : 0);


  # Kpuu,uu calculations

  # cell
  tmp1 = PermR_mcat * N1 / (exp(+N1) - 1);
  tmp2 = PermR_mcat * N1 / (1 - exp(-N1));
  tmp3 = PermR_dcat * N2 / (exp(+N2) - 1);
  tmp4 = PermR_dcat * N2 / (1 - exp(-N2));
  tmp5 = PermR_mani * N1 / (exp(+N1) - 1);
  tmp6 = PermR_mani * N1 / (1 - exp(-N1));
  Kpuuuu = (wmbase + smbase ?
              (1 + tmp1 * Y1_medium) / (1 + tmp2 * Y1_IW) :
              wdibase + sdibase ?
                (2 + tmp1 * Y1_medium + tmp3 * Y2_medium) /
                (2 + tmp2 * Y1_IW + tmp4 * Y2_IW) :
                monoacid ? (1 + tmp5 * Y1_medium) / (1 + tmp6 * Y1_IW) :
                 diacid ?
                   (2 + tmp5 * Y1_medium +
                        PermR_dani * N2 / (exp(+N2) - 1) * Y2_medium) /
                   (2 + tmp6 * Y1_IW +
                        PermR_dani * N2 / (1 - exp(-N2)) * Y2_IW) :
                   wbampholyte + sbampholyte ?
                    (3 + PermR_mani * N1a / (exp(+N1a) - 1) * Y1a_medium +
                         PermR_mcat * N1b / (exp(+N1b) - 1) * Y1b_medium +
                         PermR_amp  * Y2_medium) /
                    (3 + PermR_mani * N1a / (1 - exp(-N1a)) * Y1a_IW +
                         PermR_mcat * N1b / (1 - exp(-N1b)) * Y1b_IW +
                         PermR_amp  * Y2_IW) : 1);


  Kpuuuurbc = (smbase ?
                 (1 + PermR_mcat * N1rbc / (exp(+N1rbc) - 1) * Y1_medium) /
                 (1 + PermR_mcat * N1rbc / (1 - exp(-N1rbc)) * Y1_IWrbc) :
                 sdibase ?
                   (2 + PermR_mcat * N1rbc / (exp(+N1rbc) - 1) * Y1_medium +
                        PermR_dcat * N2rbc / (exp(+N2rbc) - 1) * Y2_medium) /
                   (2 + PermR_mcat * N1rbc / (1 - exp(-N1rbc)) * Y1_IWrbc +
                        PermR_dcat * N2rbc / (1 - exp(-N2rbc)) * Y2_IWrbc) :
                   sbampholyte ?
                     (3 + PermR_mani * N1arbc / (exp(+N1arbc) - 1) * Y1a_medium
                        + PermR_mcat * N1brbc / (exp(+N1brbc) - 1) * Y1b_medium
                        + PermR_amp * Y2_medium) /
                     (3 + PermR_mani * N1arbc / (1 - exp(-N1arbc)) * Y1a_IWrbc
                        + PermR_mcat * N1brbc / (1 - exp(-N1brbc)) * Y1b_IWrbc
                        + PermR_amp * Y2_IWrbc) : 1);


  # KIW uu,uu calculation for subcellular distribution

  tmp1 = (1 + PermR_mcat * N1mito / (exp(+N1mito) - 1) * Y1_IW) /
         (1 + PermR_mcat * N1mito / (1 - exp(-N1mito)) * Y1_mito);
  tmp2 = (1 + PermR_mcat * N1mito / (exp(+N1mito) - 1) * Y1_IW +
              PermR_dcat * N2mito / (exp(+N2mito) - 1) * Y2_IW) /
         (1 + PermR_mcat * N1mito / (1 - exp(-N1mito)) * Y1_mito +
              PermR_dcat * N2mito / (exp(+N2mito) - 1) * Y2_mito);
  tmp3 = (1 + PermR_mani * N1mito / (exp(+N1mito) - 1) * Y1_IW) /
         (1 + PermR_mani * N1mito / (1 - exp(-N1mito)) * Y1_mito);
  KIWmito = (wmbase + smbase ? tmp1 :
              wdibase + sdibase ? tmp2 :
               monoacid ? tmp3 :
                diacid ?
                 (1 + PermR_mani * N1mito / (exp(+N1mito) - 1) * Y1_IW +
                      PermR_dani * N2mito / (exp(+N2mito) - 1) * Y2_IW) /
                 (1 + PermR_mani * N1mito / (1 - exp(-N1mito)) * Y1_mito +
                      PermR_dani * N2mito / (exp(+N2mito) - 1) * Y2_mito) :
                 wbampholyte + sbampholyte ?
                  (1 + PermR_mani * N1amito / (exp(+N1amito) - 1) * Y1a_IW
                     + PermR_mcat * N1bmito / (exp(+N1bmito) - 1) * Y1b_IW
                     + PermR_amp * Y2_IW) /
                  (1 + PermR_mani * N1amito / (1 - exp(-N1amito)) * Y1a_mito
                     + PermR_mcat * N1bmito / (1 - exp(-N1bmito)) * Y1b_mito
                     + PermR_amp * exp(N2mito) * Y2_mito) : 1);

  tmp1 = (1 + PermR_mcat * N1lyso / (exp(+N1lyso) - 1) * Y1_IW) /
         (1 + PermR_mcat * N1lyso / (1 - exp(-N1lyso)) * Y1_lyso);
  tmp2 = (1 + PermR_mcat * N1lyso / (exp(+N1lyso) - 1) * Y1_IW +
              PermR_dcat * N2lyso / (exp(+N2lyso) - 1) * Y2_IW) /
         (1 + PermR_mcat * N1lyso / (1 - exp(-N1lyso)) * Y1_lyso +
              PermR_dcat * N2lyso / (exp(+N2lyso) - 1) * Y2_lyso);
  tmp3 = (1 + PermR_mani * N1lyso / (exp(+N1lyso) - 1) * Y1_IW) /
         (1 + PermR_mani * N1lyso / (1 - exp(-N1lyso)) * Y1_lyso);
  KIWlyso = (wmbase + smbase ? tmp1 :
               wdibase + sdibase ? tmp2 :
                 monoacid ? tmp3 :
                   diacid ?
                    (1 + PermR_mani * N1lyso / (exp(+N1lyso) - 1) * Y1_IW +
                         PermR_dani * N2lyso / (exp(+N2lyso) - 1) * Y2_IW) /
                    (1 + PermR_mani * N1lyso / (1 - exp(-N1lyso)) * Y1_lyso +
                         PermR_dani * N2lyso / (exp(+N2lyso) - 1) * Y2_lyso) :
                    wbampholyte + sbampholyte ?
                     (1 + PermR_mani * N1alyso / (exp(+N1alyso) - 1) * Y1a_IW
                        + PermR_mcat * N1blyso / (exp(+N1blyso) - 1) * Y1b_IW
                        + PermR_amp * Y2_IW) /
                     (1 + PermR_mani * N1alyso / (1 - exp(-N1alyso)) * Y1a_lyso
                        + PermR_mcat * N1blyso / (1 - exp(-N1blyso)) * Y1b_lyso
                        + PermR_amp * exp(N2lyso) * Y2_lyso) : 1);


  # Calculate KaAP
  # KaAP is ONLY calculated for strong bases and ampholytes with a basic
  # pKa >=7. For weak bases (pKa<7), acid and neutral compounds KaAP = 0.

  EP = (BP - 0.55) / 0.45;

  KaAP = (smbase ?
            (EP / fu * (1 + Y1_medium) / Kpuuuurbc - (f_IWrbc * (1 + Y1_IWrbc) +
             PNL * f_NLrbc + PNP * f_NPrbc)) / (AP_rbc * Y1_IWrbc) :
            sdibase ?
              (EP / fu * (1 + Y1_medium + Y2_medium) / Kpuuuurbc -
               (f_IWrbc * (1 + Y1_IWrbc + Y2_IWrbc) +
               PNL * f_NLrbc + PNP * f_NPrbc)) /
              (AP_rbc * (Y1_IWrbc + Y2_IWrbc)) :
              sbampholyte ?
                (EP / fu * (1 + Y1a_medium + Y1b_medium + Y2_medium) / Kpuuuurbc
                 - (f_IWrbc * (1 + Y1a_IWrbc + Y1b_IWrbc + Y2_IWrbc)
                 + PNL * f_NLrbc + PNP * f_NPrbc)) /
                (AP_rbc * Y1b_IWrbc) : 0);

  KaAP = (KaAP < 0 ? 0 : KaAP);


  # Kpu values incorporating subcellular distribution in both lysosomes
  # and mitochondria

  tmp1 = (f_IW * (1 + Y1_IW) + PNL * f_NL + PNP * f_NP) /
                    (1 + Y1_medium) * Kpuuuu;
  tmp2 = ((1 - f_lyso - f_mito) *
                    (f_IW * (1 + Y1_IW) + PNL * f_NL + PNP * f_NP) +
                    f_lyso * (f_IW * (1 + Y1_lyso) +
                              PNL * f_NL + PNP * f_NP) * KIWlyso +
                    f_mito * (f_IW * (1 + Y1_mito) +
                              PNL * f_NL + PNP * f_NP) * KIWmito) /
                   (1 + Y1_medium) * Kpuuuu;
  tmp3 = ((1 - f_lyso - f_mito) *
                     (f_IW * (1 + Y1_IW + Y2_IW) + PNL * f_NL + PNP * f_NP) +
                     f_lyso * (f_IW * (1 + Y1_lyso + Y2_lyso) +
                                PNL * f_NL + PNP * f_NP) * KIWlyso +
                     f_mito * (f_IW * (1 + Y1_mito + Y2_mito) +
                               PNL * f_NL + PNP * f_NP) * KIWmito) /
                    (1 + Y1_medium + Y2_medium) * Kpuuuu;
  tmp4 = ((1 - f_lyso - f_mito) *
                    (f_IW * (1 + Y1_IW) + PNL * f_NL + PNP * f_NP +
                     KaAP * AP * Y1_IW) +
                    f_lyso * (f_IW * (1 + Y1_lyso) +
                              PNL * f_NL + PNP * f_NP +
                              KaAP * AP * Y1_lyso) * KIWlyso +
                    f_mito * (f_IW * (1 + Y1_mito) +
                              PNL * f_NL + PNP * f_NP +
                              KaAP * AP * Y1_mito) * KIWmito) /
                   (1 + Y1_medium) * Kpuuuu;
  tmp5 = ((1 - f_lyso - f_mito) *
                     (f_IW * (1 + Y1_IW + Y2_IW) + PNL * f_NL + PNP * f_NP +
                      KaAP * AP * (Y1_IW + Y2_IW)) +
                     f_lyso * (f_IW * (1 + Y1_lyso + Y2_lyso) +
                               PNL * f_NL + PNP * f_NP +
                               KaAP * AP * (Y1_lyso + Y2_lyso)) * KIWlyso +
                     f_mito * (f_IW * (1 + Y1_mito + Y2_mito) +
                               PNL * f_NL + PNP * f_NP +
                               KaAP * AP * (Y1_mito + Y2_mito)) * KIWmito) /
                    (1 + Y1_medium + Y2_medium) * Kpuuuu;
  tmp6 = ((1 - f_lyso - f_mito) *
                      (f_IW * (1 + Y1_IW) + PNL * f_NL + PNP * f_NP) +
                      f_lyso * (f_IW * (1 + Y1_lyso) +
                                PNL * f_NL + PNP * f_NP) * KIWlyso +
                      f_mito * (f_IW * (1 + Y1_mito) +
                                PNL * f_NL + PNP * f_NP) * KIWmito) /
                     (1 + Y1_medium) * Kpuuuu;
  tmp7 = ((1 - f_lyso - f_mito) *
                    (f_IW * (1 + Y1_IW + Y2_IW) + PNL * f_NL + PNP * f_NP) +
                    f_lyso * (f_IW * (1 + Y1_lyso + Y2_lyso) +
                              PNL * f_NL + PNP * f_NP) * KIWlyso +
                    f_mito * (f_IW * (1 + Y1_mito + Y2_mito) +
                              PNL * f_NL + PNP * f_NP) * KIWmito) /
                   (1 + Y1_medium + Y2_medium) * Kpuuuu;
  tmp8 = ((1 - f_lyso - f_mito) *
                         (f_IW * (1 + Y1a_IW + Y1b_IW + Y2_IW) +
                          PNL * f_NL + PNP * f_NP) +
                         f_lyso * (f_IW * (1 + Y1a_lyso + Y1b_lyso + Y2_lyso) +
                                   PNL * f_NL + PNP * f_NP) * KIWlyso +
                         f_mito * (f_IW * (1 + Y1a_mito + Y1b_mito + Y2_mito) +
                                   PNL * f_NL + PNP * f_NP) * KIWmito) /
                        (1 + Y1a_medium + Y1b_medium + Y2_medium) * Kpuuuu;
  tmp9 = ((1 - f_lyso - f_mito) *
                         (f_IW * (1 + Y1a_IW + Y1b_IW + Y2_IW) +
                          PNL * f_NL + PNP * f_NP + KaAP * AP * Y1b_IW) +
                         f_lyso * (f_IW * (1 + Y1a_lyso + Y1b_lyso + Y2_lyso) +
                                   PNL * f_NL + PNP * f_NP +
                                   KaAP * AP * Y1b_lyso) * KIWlyso +
                         f_mito * (f_IW * (1 + Y1a_mito + Y1b_mito + Y2_mito) +
                                   PNL * f_NL + PNP * f_NP +
                                   KaAP * AP * Y1b_mito) * KIWmito) /
                        (1 + Y1a_medium + Y1b_medium + Y2_medium) * Kpuuuu;

  kpusub = (neutral     ? tmp1 :
            wmbase      ? tmp2 :
            wdibase     ? tmp3 :
            smbase      ? tmp4 :
            sdibase     ? tmp5 :
            monoacid    ? tmp6 :
            diacid      ? tmp7 :
            wbampholyte ? tmp8 :
            sbampholyte ? tmp9 : 0);

  kpsub = kpusub * fu_diluted;


  # Kp organelle and intracellular water

  kpu_IW = (neutral + wmbase + smbase + wdibase + sdibase + monoacid + diacid ?
              (f_IW + (PNL * f_NL + PNP * f_NP +
                       KaAP * AP * (Y1_IW + Y2_IW)) / (1 + Y1_IW + Y2_IW)) *
              (1 + Y1_IW + Y2_IW) / (1 + Y1_medium + Y2_medium) * Kpuuuu :
              wbampholyte ?
                (f_IW + (PNL * f_NL + PNP * f_NP +
                         KaAP * AP * (Y1a_IW + Y1b_IW + Y2_IW)) /
                         (1 + Y1a_IW + Y1b_IW + Y2_IW)) *
                (1 + Y1a_IW + Y1b_IW + Y2_IW) /
                (1 + Y1a_medium + Y1b_medium + Y2_medium) * Kpuuuu :
                sbampholyte ?
                  (f_IW + (PNL * f_NL + PNP * f_NP +
                           KaAP * AP * Y1b_IW) /
                           (1 + Y1a_IW + Y1b_IW + Y2_IW)) *
                  (1 + Y1a_IW + Y1b_IW + Y2_IW) /
                  (1 + Y1a_medium + Y1b_medium + Y2_medium) * Kpuuuu : 0);

  # kp_IW = kpu_IW * fu_diluted;


  kpu_lyso = (wbampholyte ?
                (f_IW + (PNL * f_NL + PNP * f_NP) /
                        (1 + Y1a_lyso + Y1b_lyso + Y2_lyso)) *
                (1 + Y1a_lyso + Y1b_lyso + Y2_lyso) /
                (1 + Y1a_medium + Y1b_medium + Y2_medium) * KIWlyso * Kpuuuu :
                sbampholyte ?
                  (f_IW + (PNL * f_NL + PNP * f_NP + KaAP * AP * Y1b_lyso) /
                          (1 + Y1a_lyso + Y1b_lyso + Y2_lyso)) *
                  (1 + Y1a_lyso + Y1b_lyso + Y2_lyso) /
                  (1 + Y1a_medium + Y1b_medium + Y2_medium) * KIWlyso * Kpuuuu :
                  # other cases:
                    (f_IW + (PNL * f_NL + PNP * f_NP +
                             KaAP * AP * (Y1_lyso + Y2_lyso)) /
                             (1 + Y1_lyso + Y2_lyso)) *
                    (1 + Y1_lyso + Y2_lyso) /
                    (1 + Y1_medium + Y2_medium) * KIWlyso * Kpuuuu);

  # kp_lyso = kpu_lyso * fu_diluted;


  kpu_mito = (wbampholyte ?
                (f_IW + (PNL * f_NL + PNP * f_NP) /
                        (1 + Y1a_mito + Y1b_mito + Y2_mito)) *
                (1 + Y1a_mito + Y1b_mito + Y2_mito) /
                (1 + Y1a_medium + Y1b_medium + Y2_medium) * KIWmito * Kpuuuu :
                sbampholyte ?
                  (f_IW + (PNL * f_NL + PNP * f_NP + KaAP * AP * Y1b_mito) /
                          (1 + Y1a_mito + Y1b_mito + Y2_mito)) *
                  (1 + Y1a_mito + Y1b_mito + Y2_mito) /
                  (1 + Y1a_medium + Y1b_medium + Y2_medium) * KIWmito * Kpuuuu :
                  # other cases:
                    (f_IW + (PNL * f_NL + PNP * f_NP +
                             KaAP * AP * (Y1_mito + Y2_mito)) /
                    (1 + Y1_mito + Y2_mito)) * (1 + Y1_mito + Y2_mito) /
                    (1 + Y1_medium + Y2_medium) * KIWmito * Kpuuuu);

  # kp_mito = kpu_mito * fu_diluted;


  # Calculate the total dissolved concentration

  # Correct for binding to plastic
  # Calculate polymer / water partition coefficient
  logkplastic = 0.97 * logPow_Tsys - 6.94;
  kplastic = pow(10, logkplastic); # NOTE: this has units of (m)

  # Surface area in contact with media
  # vol media in m3 / culturable SA m2 = height of media in well (m)
  h   = (Vbulk * 1E-3) / SAculture;
  Sam = h * 2 * Pi * Sysr; # assumes cylindrical culture vessel

} # End initialize


Dynamics {

  C_parent = (Q_total - Q_met) / Vbulk; # changes with time

  # Correct freely dissolved concentration
  Mass_dissolved = C_parent * fu_diluted * Vbulk; # mols

  C_free_diss = Mass_dissolved /
                (Vbulk + KAW * fu_diluted * fui * Vair + kpsub * Vtotalcell +
                 kplastic * fu_diluted * Sam * 1E3); # mol/L

  C_cells = C_free_diss * kpusub; # mol/L

  dt(Q_met) = ncell * K_met * C_cells; # linear metabolism

}


CalcOutputs {

  # Calculate total cell, iw and organelle concentrations, mol/l
  C_air     = KAW * fui * C_free_diss;
  C_plastic = kplastic  * (C_free_diss * 1E3); # mol/m2
  C_IW      = C_free_diss * kpu_IW;
  C_lyso    = C_free_diss * kpu_lyso;
  C_mito    = C_free_diss * kpu_mito;

  # Quantities in mol
  Q_media_free = C_free_diss * Vbulk; # mols
  Q_parent  = C_parent * Vbulk;
  Q_cells   = C_cells* Vtotalcell;
  Q_media   = C_free_diss / fu_diluted * Vbulk;
  Q_air     = C_air * Vair;
  Q_plastic = C_plastic * Sam;
  Q_IW      = C_IW * Vtotalcell * (1 - (f_lyso + f_mito));
  Q_lyso    = C_lyso * Vtotalcell * f_lyso;
  Q_mito    = C_mito * Vtotalcell * f_mito;

}

End.
